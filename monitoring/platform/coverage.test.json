{
  "rule_files": [
    "rules.json"
  ],
  "evaluation_interval": "15s",
  "tests": [
    {
      "name": "PlannerTimetableUpdateFailed detects failure",
      "interval": "1m",
      "input_series": [
        {
          "series": "timetable_ingestion_last_result{service=\"train-track-planner\",result=\"error\"}",
          "values": "1x60"
        }
      ],
      "promql_expr_test": [
        {
          "expr": "count(ALERTS{alertname=\"PlannerTimetableUpdateFailed\",alertstate=\"firing\"}) or vector(0)",
          "eval_time": "50m",
          "exp_samples": [
            {
              "labels": "{}",
              "value": 1
            }
          ]
        }
      ]
    },
